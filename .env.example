APP_NAME=GoodToGreat-Gateway
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8080
LOG_LEVEL=INFO

# DeepBridge integration (existing — unchanged).
DEEPSEEK_API_BASE_URL=http://127.0.0.1:8000

# Optional gateway key. If set, send: Authorization: Bearer <key>
# Generate one with: python scripts/gen_api_key.py
GTG_API_KEY=

# ── g4f (in-process, no sidecar needed) ────────────────────────────────────
# Replaces the old GPTBridge / Free-GPT4-WEB-API sidecar.
# g4f runs inside the GTG process — just install it and it works out of the box.
G4F_ENABLED=true
# Optional: force a specific g4f provider class name (e.g. DDG, Airforce, Blackbox).
# Leave empty to let g4f auto-select the best available provider.
G4F_PROVIDER=

# ── Ollama (local models) ───────────────────────────────────────────────────
# Install Ollama, pull a model (e.g. ollama pull qwen2.5:3b), then enable here.
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=180

# ── Legacy GPTBridge sidecar (disabled by default) ─────────────────────────
# Only needed if you are running a separate Free-GPT4-WEB-API process.
# Use G4F_ENABLED instead for new setups.
GPTBRIDGE_ENABLED=false
GPTBRIDGE_BASE_URL=http://127.0.0.1:5500
GPTBRIDGE_TIMEOUT_SECONDS=90

REQUEST_TIMEOUT_SECONDS=120

# Token-bucket rate limiting for /v1/* routes. See docs/RATE_LIMITING.md.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# Reject /v1/* request bodies larger than this before parsing.
MAX_REQUEST_BODY_BYTES=1000000

# Onyx / FreeTheAI
ONYX_BASE_URL=https://api.freetheai.org/v1
ONYX_API_KEY=
ONYX_TIMEOUT=120
